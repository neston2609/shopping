// RETROCONSOLE 1981 — PostgreSQL schema
// ORM: Prisma. Run `npx prisma migrate dev` to create migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Auth & users
// ----------------------------------------------------------------------------

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique // admin | customer
  users     User[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model User {
  id           Int     @id @default(autoincrement())
  email        String  @unique
  username     String? @unique
  passwordHash String  @map("password_hash")
  firstName    String? @map("first_name")
  lastName     String? @map("last_name")
  phone        String?
  coins        Int     @default(0) // "pixel coins" loyalty balance
  roleId       Int     @map("role_id")
  role         Role    @relation(fields: [roleId], references: [id])
  isActive     Boolean @default(true) @map("is_active")

  addresses           ShippingAddress[]
  carts               Cart[]
  orders              Order[]
  downloadLogs        DownloadLog[]
  discountCodes       DiscountCode[]
  discountRedemptions DiscountRedemption[]
  passwordResets      PasswordResetToken[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([roleId])
  @@map("users")
}

// ----------------------------------------------------------------------------
// Catalog
// ----------------------------------------------------------------------------

model Category {
  id          Int        @id @default(autoincrement())
  name        String
  slug        String     @unique
  description String?
  imageColor  String?    @map("image_color") // accent color for the retro tile
  glyph       String? // short label shown on the category tile (e.g. CART, PAD)
  parentId    Int?       @map("parent_id")
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  products    Product[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([parentId])
  @@index([slug])
  @@map("product_categories")
}

model Product {
  id            Int      @id @default(autoincrement())
  name          String
  slug          String   @unique
  description   String?
  sku           String   @unique
  price         Decimal  @db.Decimal(10, 2)
  discountPrice Decimal? @map("discount_price") @db.Decimal(10, 2)
  shippingFee   Decimal? @map("shipping_fee") @db.Decimal(10, 2)
  stock         Int      @default(0)
  status        String   @default("active") // active | inactive
  rarity        String   @default("common") // common | rare | epic | legendary
  platform      String? // e.g. "SEGA-16 / 1992 / SEALED"
  artVariant    String?  @map("art_variant") // retro card art class hint
  youtubeUrl    String?  @map("youtube_url")

  categoryId Int?      @map("category_id")
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  images     ProductImage[]
  attributes ProductAttribute[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([status])
  @@index([rarity])
  @@index([price])
  @@map("products")
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@map("product_images")
}

model ProductAttribute {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String // e.g. "size", "color"
  value     String // e.g. "Large", "Magenta"
  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@index([name])
  @@map("product_attributes")
}

// ----------------------------------------------------------------------------
// Cart
// ----------------------------------------------------------------------------

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int?       @map("user_id")
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String?    @unique // guest cart token
  items     CartItem[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@index([userId])
  @@map("carts")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int      @map("cart_id")
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId Int      @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([cartId, productId])
  @@index([cartId])
  @@map("cart_items")
}

// ----------------------------------------------------------------------------
// Orders
// ----------------------------------------------------------------------------

model Order {
  id          Int    @id @default(autoincrement())
  orderNumber String @unique @map("order_number")
  userId      Int?   @map("user_id")
  user        User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  status      String  @default("pending") // pending|paid|shipped|delivered|cancelled
  subtotal    Decimal @db.Decimal(10, 2)
  shippingFee Decimal @default(0) @map("shipping_fee") @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  // snapshot of shipping address at time of order
  shipName       String? @map("ship_name")
  shipPhone      String? @map("ship_phone")
  shipLine1      String? @map("ship_line1")
  shipLine2      String? @map("ship_line2")
  shipCity       String? @map("ship_city")
  shipState      String? @map("ship_state")
  shipPostalCode String? @map("ship_postal_code")
  shipCountry    String? @map("ship_country")

  shippingMethodId Int?            @map("shipping_method_id")
  shippingMethod   ShippingMethod? @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)

  trackingNumber String? @map("tracking_number")
  customerEmail  String  @map("customer_email")

  discountCode   String? @map("discount_code")
  discountAmount Decimal @default(0) @db.Decimal(10, 2) @map("discount_amount")

  items       OrderItem[]
  payment     Payment?
  emailLogs   EmailLog[]
  redemptions DiscountRedemption[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int      @map("order_id")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int?     @map("product_id")
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  // snapshot fields (so order history is stable even if product changes)
  name      String
  sku       String
  unitPrice Decimal  @map("unit_price") @db.Decimal(10, 2)
  quantity  Int
  lineTotal Decimal  @map("line_total") @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id            Int       @id @default(autoincrement())
  orderId       Int       @unique @map("order_id")
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method        String // card | stripe | paypal | cod | bank_transfer
  status        String    @default("pending") // pending|submitted|paid|failed|refunded
  amount        Decimal   @db.Decimal(10, 2)
  transactionId String?   @map("transaction_id")
  paidAt        DateTime? @map("paid_at")
  // bank-transfer payment slip uploaded by the customer
  slipUrl        String?   @map("slip_url")
  slipUploadedAt DateTime? @map("slip_uploaded_at")
  payerNote      String?   @map("payer_note")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@map("payments")
}

// ----------------------------------------------------------------------------
// Shipping
// ----------------------------------------------------------------------------

model ShippingMethod {
  id        Int      @id @default(autoincrement())
  name      String
  fee       Decimal  @default(0) @db.Decimal(10, 2)
  zone      String? // region/zone label, e.g. "Worldwide", "Domestic"
  estimate  String? // e.g. "1-2 days"
  enabled   Boolean  @default(true)
  orders    Order[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("shipping_methods")
}

model StoreSettings {
  id             Int      @id @default(autoincrement())
  heroHeading    String?  @map("hero_heading") // may contain HTML (e.g. <br/>, <span class="cyan">…)
  heroSubheading String?  @map("hero_subheading")
  // LINE OA chat bubble — two paths:
  //   1) Full embed snippet from LINE OA Manager → Chat plugin (preferred when
  //      that feature is available for the account).
  //   2) Fallback: just the OA's Basic ID (e.g. "@retroconsole1981"). Works for
  //      any OA, no extra LINE-side setup.
  // If both are set, the embed snippet wins.
  lineChatEmbed String? @map("line_chat_embed")
  lineBasicId   String? @map("line_basic_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("store_settings")
}

model ShippingPromo {
  id                    Int      @id @default(autoincrement())
  freeShippingEnabled   Boolean  @default(true) @map("free_shipping_enabled")
  freeShippingThreshold Decimal  @default(50) @db.Decimal(10, 2) @map("free_shipping_threshold")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("shipping_promos")
}

model ShippingAddress {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String? // "Home", "Work"
  fullName   String   @map("full_name")
  phone      String?
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String   @map("postal_code")
  country    String
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("shipping_addresses")
}

// ----------------------------------------------------------------------------
// Payment method configuration (admin)
// ----------------------------------------------------------------------------

model PaymentMethodConfig {
  id        Int      @id @default(autoincrement())
  method    String   @unique // card | stripe | paypal | cod | bank_transfer
  label     String
  enabled   Boolean  @default(false)
  // API keys stored encrypted at rest (JSON of key->encrypted value)
  configEnc String?  @map("config_enc")
  // Bank-transfer display info (public, shown to customer at checkout)
  qrImageUrl        String? @map("qr_image_url")
  bankName          String? @map("bank_name")
  bankAccountName   String? @map("bank_account_name")
  bankAccountNumber String? @map("bank_account_number")
  bankBranch        String? @map("bank_branch")
  bankInstructions  String? @map("bank_instructions")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("payment_methods")
}

// ----------------------------------------------------------------------------
// Email: SMTP settings, templates, logs
// ----------------------------------------------------------------------------

model SmtpSettings {
  id             Int      @id @default(autoincrement())
  host           String   @default("smtp.gmail.com")
  port           Int      @default(587)
  username       String?
  passwordEnc    String?  @map("password_enc") // encrypted at rest
  encryptionType String   @default("tls") @map("encryption_type") // tls | ssl
  senderEmail    String?  @map("sender_email")
  senderName     String?  @map("sender_name")
  provider       String   @default("gmail")
  enabled        Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("smtp_settings")
}

model EmailTemplate {
  id        Int      @id @default(autoincrement())
  key       String   @unique // order_confirmation, payment_confirmation, ...
  name      String
  subject   String
  body      String // HTML with {{variables}}
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("email_templates")
}

model EmailLog {
  id             Int       @id @default(autoincrement())
  recipient      String
  subject        String
  status         String // sent | failed | queued
  errorMessage   String?   @map("error_message")
  templateKey    String?   @map("template_key")
  relatedOrderId Int?      @map("related_order_id")
  relatedOrder   Order?    @relation(fields: [relatedOrderId], references: [id], onDelete: SetNull)
  sentAt         DateTime? @map("sent_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([status])
  @@index([relatedOrderId])
  @@map("email_logs")
}

// ----------------------------------------------------------------------------
// Downloads: SFTP source config + download audit log
// ----------------------------------------------------------------------------

model SftpSettings {
  id          Int      @id @default(autoincrement())
  protocol    String   @default("sftp") // sftp | ftp | ftps
  host        String?
  port        Int      @default(22)
  username    String?
  passwordEnc String?  @map("password_enc") // encrypted at rest
  basePath    String   @default("/") @map("base_path")
  enabled     Boolean  @default(false)
  // Affiliate gate shown before a customer download
  affLink         String? @map("aff_link")
  affDelaySeconds Int     @default(0) @map("aff_delay_seconds")
  // Folder.jpg thumbnail display height (width is auto, preserves aspect)
  folderThumbHeight Int   @default(48) @map("folder_thumb_height")
  // How many file/folder entries per page on the public downloads browser.
  downloadPageSize  Int   @default(50) @map("download_page_size")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("sftp_settings")
}

// ----------------------------------------------------------------------------
// Discounts
// ----------------------------------------------------------------------------

model DiscountCode {
  id           Int       @id @default(autoincrement())
  code         String    @unique
  description  String?
  type         String    @default("percent") // percent | fixed
  value        Decimal   @db.Decimal(10, 2) // percent (e.g. 15) OR fixed amount
  minSubtotal  Decimal   @default(0) @db.Decimal(10, 2) @map("min_subtotal")
  validFrom    DateTime? @map("valid_from")
  validUntil   DateTime? @map("valid_until")
  usageLimit   Int? @map("usage_limit") // total uses across all users (null = unlimited)
  usedCount    Int       @default(0) @map("used_count")
  perUserLimit Int       @default(0) @map("per_user_limit") // 0 = unlimited
  userId       Int?      @map("user_id") // if set, only this user may redeem
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled      Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  redemptions DiscountRedemption[]

  @@index([userId])
  @@map("discount_codes")
}

model DiscountRedemption {
  id        Int          @id @default(autoincrement())
  codeId    Int          @map("code_id")
  code      DiscountCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  userId    Int?         @map("user_id")
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId   Int?         @map("order_id")
  order     Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  amount    Decimal      @db.Decimal(10, 2)
  createdAt DateTime     @default(now()) @map("created_at")

  @@index([codeId])
  @@index([userId])
  @@map("discount_redemptions")
}

model DownloadSource {
  id          Int      @id @default(autoincrement())
  name        String   @unique // e.g. "NAS @ home", "OneDrive primary"
  protocol    String   @default("sftp") // sftp | ftp | ftps | onedrive | googledrive
  enabled     Boolean  @default(true)

  // SFTP / FTP / FTPS
  host        String?
  port        Int?     @default(22)
  username    String?
  passwordEnc String?  @map("password_enc")
  basePath    String?  @default("/") @map("base_path")

  // OAuth2 for OneDrive / Google Drive
  oauthClientId        String?   @map("oauth_client_id")
  oauthClientSecretEnc String?   @map("oauth_client_secret_enc")
  oauthRefreshTokenEnc String?   @map("oauth_refresh_token_enc")
  oauthAccessTokenEnc  String?   @map("oauth_access_token_enc")
  oauthExpiresAt       DateTime? @map("oauth_expires_at")
  oauthAccount         String?   @map("oauth_account") // displayed login (email / drive name)

  categories DownloadCategory[]
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("download_sources")
}

model DownloadCategory {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?  @map("image_url")
  sourceId    Int?     @map("source_id")
  source      DownloadSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  sftpPath    String   @map("sftp_path") // absolute path / folder id within the chosen source
  enabled     Boolean  @default(true)
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([sourceId])
  @@map("download_categories")
}

model DownloadHideRule {
  id        Int      @id @default(autoincrement())
  pattern   String   // exact name or wildcard (e.g. "*.jpg", "*backup*", "Thumbs.db")
  enabled   Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("download_hide_rules")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash") // sha256 of the raw token sent by email
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model DownloadLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  path      String
  fileName  String   @map("file_name")
  sizeBytes Int?     @map("size_bytes")
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("download_logs")
}
